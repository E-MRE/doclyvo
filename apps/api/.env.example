ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
MAX_UPLOAD_SIZE_MB=100
TEMP_DIR=/tmp/doclyvo
RETENTION_HOURS=24
# "soffice" works as-is on Linux where LibreOffice puts it on PATH. On macOS, the Homebrew
# cask doesn't — point this at the app bundle instead, e.g.
# /Applications/LibreOffice.app/Contents/MacOS/soffice
LIBREOFFICE_BINARY=soffice
LIBREOFFICE_TIMEOUT_SECONDS=60
# Optional — only needed for the `sign` tool's authenticated hash + audit-log path.
# Unset (the default) is a valid, supported state: `sign` still works anonymously,
# it just never touches a database. Run `docker compose up -d` for a local Postgres.
DATABASE_URL=postgresql+asyncpg://doclyvo:doclyvo@localhost:5432/doclyvo
